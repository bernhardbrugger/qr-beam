{
  "name": "qr-beam",
  "version": "1.0.0",
  "private": true,
  "description": "Air-gapped file transfer in a single HTML file (dev dependencies only used for tests).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/core.test.js test/vendor.test.js test/e2e.test.js",
    "test:unit": "node --test test/core.test.js test/vendor.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "screenshots": "node scripts/screenshots.mjs",
    "bench": "node scripts/bench.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "playwright": "^1.65.1",
    "qrcode-generator": "2.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernhardbrugger/qr-beam.git"
  }
}
